# 敏感配置，不要提交到 git！复制为 .env.local 后使用：
#   cp .env.example .env.local

# API Key（DeepSeek、Kimi、SiliconFlow 等 API Key 认证的平台）
# API_KEY=sk-xxx

# Cookie（Xiaomi MiMo 等 Cookie 认证的平台）
# 从浏览器开发者工具 Network 面板复制
# COOKIE='api-platform_serviceToken="xxx"; userId=123'

# --- 以下为非敏感配置，可在 .env 中设置 ---

# fetch.js 默认平台（大小写不敏感）
# 官方接口：DeepSeek Kimi Kimi-EN SiliconFlow SiliconFlow-EN OpenRouter Novita StepFun StepFun-EN
# 自定义接口：MiniMax Xiaomi-MiMo Xiaomi-MiMo-Plan Zhipu Zhipu-Resource
# PLATFORM=DeepSeek

# raw-fetch.js 默认 URL
# URL=https://api.deepseek.com/user/balance
